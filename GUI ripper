local function sv(v)
	if typeof(v) == "Color3" then
		return string.format("Color3.new(%.6f, %.6f, %.6f)", v.R, v.G, v.B)
	elseif typeof(v) == "Vector2" then
		return string.format("Vector2.new(%.6f, %.6f)", v.X, v.Y)
	elseif typeof(v) == "Vector3" then
		return string.format("Vector3.new(%.6f, %.6f, %.6f)", v.X, v.Y, v.Z)
	elseif typeof(v) == "UDim" then
		return string.format("UDim.new(%.6f, %d)", v.Scale, math.floor(v.Offset))
	elseif typeof(v) == "UDim2" then
		return string.format("UDim2.new(%.6f, %d, %.6f, %d)", v.X.Scale, math.floor(v.X.Offset), v.Y.Scale, math.floor(v.Y.Offset))
	elseif typeof(v) == "Rect" then
		return string.format("Rect.new(%s, %s)", sv(v.Min), sv(v.Max))
	elseif typeof(v) == "EnumItem" then
		return string.format("Enum.%s.%s", tostring(v.EnumType):gsub("Enum.", ""), v.Name)
	elseif typeof(v) == "ColorSequence" then
		local t = {}
		for _, k in ipairs(v.Keypoints) do
			table.insert(t, string.format("ColorSequenceKeypoint.new(%.6f, Color3.new(%.6f, %.6f, %.6f))", k.Time, k.Value.R, k.Value.G, k.Value.B))
		end
		return "ColorSequence.new({"..table.concat(t,",").."})"
	elseif typeof(v) == "NumberSequence" then
		local t = {}
		for _, k in ipairs(v.Keypoints) do
			table.insert(t, string.format("NumberSequenceKeypoint.new(%.6f, %.6f, %.6f)", k.Time, k.Value, k.Envelope or 0))
		end
		return "NumberSequence.new({"..table.concat(t,",").."})"
	elseif type(v) == "table" then
		local parts = {}
		for i, val in ipairs(v) do
			table.insert(parts, sv(val))
		end
		return "{"..table.concat(parts, ",").."}"
	elseif type(v) == "string" then
		return string.format("%q", v)
	elseif type(v) == "boolean" or type(v) == "number" then
		return tostring(v)
	else
		return "nil"
	end
end

local function safeFont(inst)
	local ok, face = pcall(function() return inst.FontFace end)
	if ok and face then
		local family = face.Family or "rbxasset://fonts/families/SourceSansPro.json"
		local weight = face.Weight or Enum.FontWeight.Regular
		local style = face.Style or Enum.FontStyle.Normal
		return string.format('Font.new(%q, Enum.FontWeight.%s, Enum.FontStyle.%s)', family, weight.Name, style.Name)
	end
	if inst.Font then
		return string.format("Enum.Font.%s", inst.Font.Name)
	end
	return "Enum.Font.SourceSans"
end

local function sanitizeName(n)
	local s = tostring(n or "")
	if s == "" then s = "inst" end
	local out = s:gsub("%W", "")
	if out == "" then out = "inst" end
	return out
end

local function ripElement(inst, parentName)
	local lines = {}
	local className = inst.ClassName
	local name = sanitizeName(inst.Name)
	table.insert(lines, string.format("local %s = Instance.new(%q)", name, className))
	table.insert(lines, string.format("%s.Name = %q", name, inst.Name))
	if parentName ~= name then
		table.insert(lines, string.format("%s.Parent = %s", name, parentName))
	end

	local props = {
		"Size","Position","AnchorPoint","Rotation","ZIndex","Visible",
		"BackgroundColor3","BackgroundTransparency","BorderColor3","BorderSizePixel",
		"Image","ImageColor3","ImageTransparency","ResampleMode",
		"Text","TextColor3","TextTransparency","TextStrokeColor3","TextStrokeTransparency",
		"TextScaled","TextSize","LayoutOrder","ClipsDescendants","AutomaticSize",
		"CanvasSize","SizeConstraint","ZIndexBehavior","Selectable","Active"
	}

	for _, prop in ipairs(props) do
		pcall(function()
			local v = inst[prop]
			if v ~= nil then
				table.insert(lines, string.format("%s.%s = %s", name, prop, sv(v)))
			end
		end)
	end

	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		table.insert(lines, string.format("%s.FontFace = %s", name, safeFont(inst)))
		pcall(function()
			if inst.TextWrapped ~= nil then
				table.insert(lines, string.format("%s.TextWrapped = %s", name, tostring(inst.TextWrapped)))
			end
		end)
	end

	if inst:IsA("UIGradient") then
		table.insert(lines, string.format("%s.Color = %s", name, sv(inst.Color)))
		table.insert(lines, string.format("%s.Rotation = %s", name, sv(inst.Rotation)))
		table.insert(lines, string.format("%s.Offset = %s", name, sv(inst.Offset)))
		table.insert(lines, string.format("%s.Transparency = %s", name, sv(inst.Transparency)))
	elseif inst:IsA("UICorner") then
		table.insert(lines, string.format("%s.CornerRadius = %s", name, sv(inst.CornerRadius)))
	elseif inst:IsA("UIScale") then
		table.insert(lines, string.format("%s.Scale = %s", name, sv(inst.Scale)))
	elseif inst:IsA("UIStroke") then
		table.insert(lines, string.format("%s.Color = %s", name, sv(inst.Color)))
		table.insert(lines, string.format("%s.Thickness = %s", name, sv(inst.Thickness)))
		table.insert(lines, string.format("%s.Transparency = %s", name, sv(inst.Transparency)))
		table.insert(lines, string.format("%s.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual", name))
	elseif inst:IsA("UIListLayout") then
		table.insert(lines, string.format("%s.Padding = %s", name, sv(inst.Padding)))
		table.insert(lines, string.format("%s.FillDirection = %s", name, sv(inst.FillDirection)))
		table.insert(lines, string.format("%s.HorizontalAlignment = %s", name, sv(inst.HorizontalAlignment)))
		table.insert(lines, string.format("%s.VerticalAlignment = %s", name, sv(inst.VerticalAlignment)))
		table.insert(lines, string.format("%s.SortOrder = %s", name, sv(inst.SortOrder)))
	end

	if inst:IsA("UIAspectRatioConstraint") then
		pcall(function()
			table.insert(lines, string.format("%s.AspectRatio = %s", name, sv(inst.AspectRatio)))
			table.insert(lines, string.format("%s.DominantAxis = %s", name, sv(inst.DominantAxis)))
		end)
	end

	if inst:IsA("UISizeConstraint") then
		pcall(function()
			if inst.MinSize then
				table.insert(lines, string.format("%s.MinSize = %s", name, sv(inst.MinSize)))
			end
			if inst.MaxSize then
				table.insert(lines, string.format("%s.MaxSize = %s", name, sv(inst.MaxSize)))
			end
		end)
	end

	for _, ch in ipairs(inst:GetChildren()) do
		local cl = ripElement(ch, name)
		for _, l in ipairs(cl) do
			table.insert(lines, l)
		end
	end

	return lines
end

