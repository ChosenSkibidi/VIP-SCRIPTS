        v.Position = UDim2.new(v.Position.X.Scale, v.Position.X.Offset, v.Position.Y.Scale, v.Position.Y.Offset - 50)
        v.BackgroundTransparency = 1
        t:Create(v, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = d[v].pos, BackgroundTransparency = d[v].trans or 0}):Play()
        if v:IsA("TextLabel") or v:IsA("TextButton") then
            local ft = v.TextTransparency
            v.TextTransparency = 1
            t:Create(v, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = ft}):Play()
        elseif v:IsA("ImageLabel") or v:IsA("ImageButton") then
            local it = v.ImageTransparency
            v.ImageTransparency = 1
            t:Create(v, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {ImageTransparency = it}):Play()
        end
    end
end

