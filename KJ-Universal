local function setupPhone(character)
    local rs = game:GetService("ReplicatedStorage")
    local resources = rs:FindFirstChild("Resources")
    if not resources then return end

    local phoneModel = resources:FindFirstChild("le phone")
    if not phoneModel then return end

    local phoneClone = phoneModel:Clone()
    local rightArm = character:FindFirstChild("Right Arm")
    if not rightArm then return end

    phoneClone.Parent = character
    if not phoneClone.PrimaryPart then
        local part = phoneClone:FindFirstChildWhichIsA("BasePart")
        if not part then return end
        phoneClone.PrimaryPart = part
    end

    local joint = Instance.new("Motor6D")
    joint.Part0 = rightArm
    joint.Part1 = phoneClone.PrimaryPart
    joint.C0 = CFrame.new(0, -1, 0)
    joint.Name = "PhoneJoint"
    joint.Parent = rightArm

    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")

    local sound1 = Instance.new("Sound")
    sound1.SoundId = "rbxassetid://17325174223"
    sound1.Parent = torso
    sound1:Play()

    local sound2 = Instance.new("Sound")
    sound2.SoundId = "rbxassetid://17325206534"
    sound2.Parent = torso
    sound2:Play()

    local sound3 = Instance.new("Sound")
    sound3.SoundId = "rbxassetid://17325211957"
    sound3.Parent = torso
    task.delay(1.34, function()
        sound3:Play()
    end)

    task.delay(1.34, function()
        joint:Destroy()
        if phoneClone.Handle then
            if phoneClone.Handle:FindFirstChild("Meshes/testmodel_Cube.002") then
                phoneClone.Handle["Meshes/testmodel_Cube.002"]:Destroy()
            end
            phoneClone.Handle:Destroy()
        end
        task.wait(5)
        phoneClone:Destroy()
    end)

    local function cleanup()
        joint:Destroy()
        phoneClone:Destroy()
        if torso then
            for _, c in pairs(torso:GetChildren()) do
                if c:IsA("Sound") then
                    c:Destroy()
                end
            end
        end
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.Running:Connect(cleanup)
        humanoid.Jumping:Connect(cleanup)
    end
end

