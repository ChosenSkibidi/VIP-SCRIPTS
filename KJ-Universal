local function clearTimers()
	if rt then task.cancel(rt) rt = nil end
	if rc then task.cancel(rc) rc = nil end
end

local function resetCombo()
	clearTimers()
	s = 0
	canPunch = true
end

local function startComboResetTimer()
	if rt then task.cancel(rt) rt = nil end
	rt = task.delay(comboResetTime, function()
		resetCombo()
	end)
end

local function applyInputDelay(delayTime)
	punchDelay = true
	task.delay(delayTime, function()
		punchDelay = false
	end)
end

local function applyCooldown()
	canPunch = false
	punchDelay = true
	task.delay(comboCooldown, function()
		canPunch = true
		punchDelay = false
		s = 0
	end)
end

local function punch()
	if not canPunch or punchDelay then return end
	s += 1
	if s > 4 then s = 1 end
	if s == 1 then p1() applyInputDelay(d1) startComboResetTimer()
	elseif s == 2 then p2() applyInputDelay(d2) startComboResetTimer()
	elseif s == 3 then p3() applyInputDelay(d3) startComboResetTimer()
	elseif s == 4 then p4() applyCooldown()
	end
end

