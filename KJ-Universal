local function v670(func, fps)
	local interval = 1 / (fps or 60)
	local elapsed = 0
	local active = true

	local stopFunc = function()
		active = false
	end

	task.spawn(function()
		while active do
			elapsed += RunService.RenderStepped:Wait()
			while elapsed >= interval do
				elapsed -= interval
				func(stopFunc)
				if not active then break end
			end
		end
	end)

	return stopFunc
end

local v283, v284, v285 = 0, 0, 0
local v287 = nil

local function randomSign()
	return math.random(1, 2) == 1 and -1 or 1
end

local function addShake(intensity)
	local player = Players.LocalPlayer
	if player:GetAttribute("S_ReducedCamshake") then
		intensity /= 2
	end

	if not v287 then
		v287 = v670(function(stop)
			v283 *= randomSign()
			v284 *= randomSign()
			v285 *= randomSign()

			v283 *= 0.85
			v284 *= 0.85
			v285 *= 0.85

			local camera = workspace.CurrentCamera
			camera.CFrame *= CFrame.new(v283, v284, v285)

			if math.abs(v283) <= 0.05 and math.abs(v284) <= 0.05 and math.abs(v285) <= 0.05 then
				stop()
				v287 = nil
			end
		end, 60)
	end

	v283 += intensity * randomSign()
	v284 += intensity * randomSign()
	v285 += intensity * randomSign()
end

local function triggerCamShake(params)
	if params.Effect == "Camshake" then
		if params.Last then
			task.spawn(function()
				for _ = 1, params.Last / 0.03 do
					addShake(params.Intensity)
					params.Intensity *= 0.9
					task.wait(0.03)
				end
			end)
		else
			addShake(params.Intensity)
		end
	end
end

